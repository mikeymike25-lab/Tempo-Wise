rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document and all personal subcollections
    // (tasks, routines, focusSessions, reminders)
    // Only the authenticated owner can read, write, update, or delete
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections under the user
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
